# Copy this file to .env and fill in real values. .env is gitignored;
# this template is the only thing that should be committed.

# Optional. Without it, app/llm.py falls back to a template answer
# (no LLM call) instead of calling Claude.
ANTHROPIC_API_KEY=

# Optional. Set to 1 once the sentence-transformers model is cached
# locally (~/.cache/huggingface) to skip the Hugging Face Hub network
# check on every startup — faster boot, no dependency on HF being reachable.
# HF_HUB_OFFLINE=1
